# Copy to .env and change for anything beyond a laptop demo.

# Runs the bundled Airflow. Set to empty (COMPOSE_PROFILES=) to use your own Airflow
# instead; see docs/shared-airflow.md.
COMPOSE_PROFILES=airflow
POSTGRES_PASSWORD=postgres
SENTINEL_DB_PASSWORD=sentinel
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_PASSWORD=admin

# Load knobs
EVENTS_PER_MINUTE=300
ATTACKS_PER_HOUR=6

# Alert email (Grafana). SMTP_PASSWORD is an app password, not your normal one:
# Yahoo > Account security > Generate app password. Gmail: smtp.gmail.com:587.
SMTP_ENABLED=false
SMTP_HOST=smtp.mail.yahoo.com:587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# Optional Microsoft Teams channel (Workflows webhook). Leave TEAMS_SEVERITIES=none to keep it off.
TEAMS_WEBHOOK_URL=
TEAMS_SEVERITIES=none

# Host ports for the web UIs (change if something else on your machine uses them)
GRAFANA_PORT=13000
AIRFLOW_PORT=18080
SPARK_UI_PORT=14040
KAFKA_UI_PORT=18085
POSTGRES_PORT=15432
