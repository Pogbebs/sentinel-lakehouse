{
  "uid": "sentinel-overview",
  "title": "Sentinel: Credential Abuse Overview",
  "tags": [
    "sentinel",
    "security"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 12,
      "type": "stat",
      "title": "Stalled streams",
      "description": "Streaming queries with no heartbeat for 10 minutes, or stopped. The job restarts itself at that point (STALL_TIMEOUT_SECONDS); anything above 0 for long means the restart is not fixing it.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sentinel-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sentinel-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) filter (where last_seen_at < now() - interval '10 minutes' or status in ('stalled', 'terminated')) as stalled from pipeline_heartbeat"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Streaming health (seconds since last heartbeat)",
      "description": "One row per Spark streaming query, upserted every micro-batch. Idle means running with no new data.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sentinel-pg"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 19,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sentinel-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select query_name as stream, status, round(extract(epoch from now() - last_seen_at))::int as seconds_since_heartbeat, batch_id, input_rows as last_batch_rows, last_seen_at from pipeline_heartbeat order by query_name"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "seconds_since_heartbeat"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 120
                    },
                    {
                      "color": "red",
                      "value": 600
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "running": {
                        "color": "green",
                        "index": 0
                      },
                      "idle": {
                        "color": "green",
                        "index": 1
                      },
                      "starting": {
                        "color": "blue",
                        "index": 2
                      },
                      "stalled": {
                        "color": "red",
                        "index": 3
                      },
                      "terminated": {
                        "color": "red",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
